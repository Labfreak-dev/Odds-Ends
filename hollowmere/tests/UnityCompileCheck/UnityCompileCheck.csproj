<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compile-only check of the Unity scripts against Unity's reference assemblies from NuGet
       (2021.3 module DLLs; the API surface used here is unchanged in Unity 6). Nothing runs.
       Editor scripts under Assets/Editor reference UnityEditor (and glTFast's editor importer)
       and are not part of this check; Unity compiles them inside the editor.
       dotnet build tests/UnityCompileCheck -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);ENABLE_LEGACY_INPUT_MANAGER</DefineConstants>
    <NoWarn>CS0649;CS0414;CS0169</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Scripts/**/*.cs" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" />
    <PackageReference Include="Unity3D.UnityEngine.UI" Version="2020.3.21" />
  </ItemGroup>
</Project>
